# Create an API key at https://elevenlabs.io/app/settings/api-keys
# Scopes needed: ElevenAgents (read + write).
ELEVENLABS_API_KEY=

# Filled in for you by `yarn agent:sync`. Leave empty on first run.
ELEVENLABS_AGENT_ID=

# Port for the token server (Vite proxies /api to it in development).
PORT=8787
