{
  "name": "karibu",
  "version": "0.1.0",
  "private": true,
  "description": "A multilingual (English, French, Swahili) voice and text agent built with ElevenAgents and React, with a secure token server and agent-as-code setup.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "agent:sync": "tsx scripts/sync-agent.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "yarn typecheck && yarn test && yarn build"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.72.0",
    "@elevenlabs/react": "^1.18.0",
    "@hono/node-server": "^2.1.5",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "yarn@1.22.22"
}
